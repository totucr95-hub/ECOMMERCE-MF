{
  "realm": "ecommerce-mf",
  "enabled": true,
  "displayName": "Ecommerce MF",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrador del sistema"
      },
      {
        "name": "manager",
        "description": "Gestor operativo"
      },
      {
        "name": "customer",
        "description": "Cliente"
      }
    ]
